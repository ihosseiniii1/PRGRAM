# ---- Required ----
BOT_TOKEN=
OWNER_ID=

# ---- Session encryption key (install.sh generates it; if you lose it, all saved sessions are unrecoverable) ----
SESSION_KEY=

# ---- Recommended ----
# Get your own API_ID / API_HASH from my.telegram.org
API_ID=
API_HASH=

# ---- Domain (install.sh or `selfpanel domain` fills these in automatically) ----
# The domain's A record must point to the server IP. Caddy obtains the SSL certificate automatically.
DOMAIN=
WEB_BASE_URL=
# With a domain: 1 (behind Caddy); without a domain: 0
TRUST_PROXY=0
# With a domain: 127.0.0.1 (the direct port is closed); without a domain: 0.0.0.0
BIND_IP=0.0.0.0
# With a domain: domain ; without a domain: leave empty
COMPOSE_PROFILES=
OPEN_ACCESS=1
MAX_USERS=500

# ---- Host port (inside the container it is always 8787) ----
HOST_PORT=8787
MEM_LIMIT=768m
CPU_LIMIT=1.5
