#!/usr/bin/env bash
# selfpanel - management CLI for PR GRAM Helper
# Interactive menu:  selfpanel
# Direct commands:   selfpanel status|logs|restart|update|backup|clean|optimize|...   (see: selfpanel help)
set -uo pipefail

DIR="${INSTALL_DIR:-/opt/prgram}"
CT="prgram"
BK="$DIR/backups"

if [[ -t 1 ]]; then
  R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; B=$'\e[1m'; N=$'\e[0m'
else
  R=""; G=""; Y=""; C=""; B=""; N=""
fi
ok()    { echo "${G}✔${N} $*"; }
warn()  { echo "${Y}!${N} $*"; }
err()   { echo "${R}✖${N} $*" >&2; }
pause() { [[ -t 0 && -z "${NOPAUSE:-}" ]] && { echo; read -rp "Press Enter to continue..." _; }; }
ask()   { local a; read -rp "$1 [y/N] " a || return 1; [[ "$a" =~ ^[Yy]$ ]]; }

usage() {
  echo "Usage: selfpanel [status|start|stop|restart|logs [N]|link|update [dir]|backup|restore [file]|clean|vacuum|optimize|limits|config|health|domain|logs-ssl|uninstall|help]"
  echo "Run without arguments for the interactive menu."
}

case "${1:-}" in help|-h|--help) usage; exit 0;; esac

[[ -d "$DIR" ]]  || { err "Install directory $DIR not found"; exit 1; }
[[ $EUID -eq 0 ]] || { err "Run as root (sudo selfpanel)"; exit 1; }
dc() { (cd "$DIR" && docker compose "$@"); }

# Docker refuses a CPU limit above the number of cores; keep .env consistent
ensure_cpu_limit() {
  local cores cur; cores=$(nproc 2>/dev/null || echo 1); cur=$(grep -E '^CPU_LIMIT=' "$DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '\r')
  cur=${cur:-1.5}
  if awk -v l="$cur" -v c="$cores" 'BEGIN{exit !(l+0 > c+0)}'; then
    envset CPU_LIMIT "$cores"; warn "CPU_LIMIT=$cur exceeds the $cores core(s) here; set to $cores"
  fi
}

envget() { grep -E "^$1=" "$DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '\r'; }
envset() { # envset KEY VALUE  (safe for values containing | & \)
  local esc; esc="$(printf '%s' "$2" | sed -e 's/[\\|&]/\\&/g')"
  [[ -s "$DIR/.env" && -n "$(tail -c1 "$DIR/.env")" ]] && echo >> "$DIR/.env"
  if grep -qE "^$1=" "$DIR/.env"; then sed -i "s|^$1=.*|$1=$esc|" "$DIR/.env"; else printf '%s=%s\n' "$1" "$2" >> "$DIR/.env"; fi
}
host_port() { local p; p=$(envget HOST_PORT); echo "${p:-8787}"; }

open_ports() {
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
    local p; for p in "$@"; do ufw allow "$p" >/dev/null; done
  elif command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    local p; for p in "$@"; do firewall-cmd --permanent --add-port="$p" >/dev/null; done
    firewall-cmd --reload >/dev/null
  fi
}

wait_healthy() { # waits up to ~2 minutes for the app container
  local st i
  for ((i = 0; i < 60; i++)); do
    st=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$CT" 2>/dev/null || echo missing)
    case "$st" in
      healthy|running) return 0;;
      unhealthy|exited|dead) return 1;;
    esac
    sleep 2
  done
  return 1
}

[[ -f "$DIR/.env" ]] && ensure_cpu_limit

# ---------------- status ----------------
cmd_status() {
  echo "${B}== Service status ==${N}"
  dc ps
  local h; h=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}}' "$CT" 2>/dev/null || echo "-")
  echo "Health: $h"
  echo; echo "${B}== Container resources ==${N}"
  docker stats --no-stream --format 'CPU {{.CPUPerc}} | RAM {{.MemUsage}} ({{.MemPerc}}) | NET {{.NetIO}}' "$CT" 2>/dev/null || warn "The container is not running"
  echo; echo "${B}== Server ==${N}"
  free -h | sed -n '1,3p'
  df -h / "$DIR/data" 2>/dev/null | awk 'NR==1||!seen[$1]++'
  echo "Load: $(cut -d' ' -f1-3 /proc/loadavg)   Uptime: $(uptime -p)"
  echo; echo "Data size: $(du -sh "$DIR/data" 2>/dev/null | cut -f1)   DB: $(du -sh "$DIR/data/prgram.db"* 2>/dev/null | awk '{s=s" "$1}END{print s}')"
}

cmd_start()   { dc up -d && ok "Started"; }
cmd_stop()    { dc stop && ok "Stopped"; }
cmd_restart() { dc restart && ok "Restarted"; }
cmd_logs()    { dc logs -f --tail="${1:-100}"; }

cmd_adminlink() {
  local base tok; base=$(envget WEB_BASE_URL); base="${base%/}"
  tok=$(cat "$DIR/data/web_token.txt" 2>/dev/null || true)
  if [[ -z "$tok" ]]; then warn "The token has not been created yet (the service must start once first)"; return; fi
  [[ -z "$base" ]] && base="http://$(curl -s4 --max-time 4 https://api.ipify.org || echo SERVER_IP):$(host_port)"
  echo "${B}Admin link (secret, do not share):${N}"
  echo "$base/admin/panel/accounts?t=$tok"
  [[ "$base" == http://* ]] && warn "This link is not HTTPS; put the panel behind a TLS reverse proxy (selfpanel domain)."
}

# ---------------- domain / SSL ----------------
cmd_domain() {
  local cur new; cur=$(envget DOMAIN)
  echo "${B}== Domain and HTTPS ==${N}"
  echo "Current domain: ${cur:-none}"
  read -rp "New domain (e.g. panel.example.com | empty = no change | - = remove domain): " new
  [[ -z "$new" ]] && return 0
  if [[ "$new" == "-" ]]; then
    envset DOMAIN ""; envset WEB_BASE_URL ""; envset TRUST_PROXY 0; envset BIND_IP 0.0.0.0; envset COMPOSE_PROFILES ""
    dc --profile domain rm -sf caddy >/dev/null 2>&1 || true
    open_ports "$(host_port)/tcp"
    dc up -d --force-recreate app && ok "Domain removed; the panel is reachable at IP:port"
    return 0
  fi
  new=$(echo "$new" | tr '[:upper:]' '[:lower:]' | sed -E 's#^https?://##; s#/.*$##' | tr -d '[:space:]')
  [[ "$new" =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$ ]] || { err "Invalid domain"; return 1; }
  local sip dip
  sip=$(curl -4fsS --max-time 6 https://api.ipify.org 2>/dev/null || true)
  dip=$(getent ahostsv4 "$new" 2>/dev/null | awk '{print $1; exit}')
  echo "Server IP: ${sip:-?}   |   Domain A record: ${dip:-not found}"
  if [[ -z "$dip" || ( -n "$sip" && "$dip" != "$sip" ) ]]; then
    warn "The A record does not point to this server yet (Cloudflare: use the gray cloud)."
    ask "Continue anyway?" || return 0
  fi
  open_ports 80/tcp 443/tcp 443/udp
  envset DOMAIN "$new"; envset WEB_BASE_URL "https://$new"; envset TRUST_PROXY 1
  envset BIND_IP 127.0.0.1; envset COMPOSE_PROFILES domain
  dc up -d --force-recreate --remove-orphans && ok "Applied: https://$new"
  echo "The SSL certificate is issued a few seconds later. Log: selfpanel logs-ssl"
}

cmd_sslogs() { docker logs -f --tail=80 prgram-caddy; }

# ---------------- update / backup ----------------
cmd_update() {
  local src="${1:-}" f
  if [[ -z "$src" ]]; then read -rp "Path to the folder containing the new app.py: " src; fi
  src="${src/#\~/$HOME}"
  [[ -f "$src/app.py" ]] || { err "$src/app.py not found"; return 1; }
  cmd_backup quiet
  if [[ "$src" -ef "$DIR" ]]; then
    warn "The source is the install directory; just rebuilding."
  else
    for f in app.py panel_ui.html requirements.txt Dockerfile docker-compose.yml Caddyfile; do
      [[ -f "$src/$f" ]] && cp -f "$src/$f" "$DIR/$f"
    done
    if [[ -f "$src/selfpanel" && ! "$src/selfpanel" -ef /usr/local/bin/selfpanel ]]; then
      install -m 0755 "$src/selfpanel" /usr/local/bin/selfpanel.new && mv -f /usr/local/bin/selfpanel.new /usr/local/bin/selfpanel \
        && ok "selfpanel updated (takes effect on the next run)"
    fi
  fi
  dc up -d --build --remove-orphans || { err "Build failed; your previous backup is in $BK"; return 1; }
  if wait_healthy; then ok "Updated and healthy"
  else err "The app is not healthy after the update. Check: selfpanel logs  |  roll back with: selfpanel restore"; return 1; fi
}

cmd_backup() {
  mkdir -p "$BK"; chmod 700 "$BK"
  local f="$BK/prgram-$(date +%Y%m%d-%H%M%S).tar.gz"
  # checkpoint so the WAL is merged into the main DB file
  docker exec "$CT" python -c "import sqlite3;c=sqlite3.connect('/app/data/prgram.db');c.execute('PRAGMA wal_checkpoint(TRUNCATE)')" 2>/dev/null || true
  if tar -czf "$f" -C "$DIR" data .env 2>/dev/null; then
    chmod 600 "$f"
    ok "Backup: $f ($(du -h "$f" | cut -f1))"
  else
    err "Backup failed"; rm -f "$f"; return 1
  fi
  [[ "${1:-}" == quiet ]] || warn "This file contains users' Telegram sessions and the encryption key; store it somewhere safe."
  ls -1t "$BK"/prgram-*.tar.gz 2>/dev/null | tail -n +8 | xargs -r rm -f   # keep only the last 7 backups
}

cmd_restore() {
  local f="${1:-}"
  if [[ -z "$f" ]]; then ls -1t "$BK"/*.tar.gz 2>/dev/null | head; read -rp "Path to the backup file: " f; fi
  f="${f/#\~/$HOME}"
  [[ -f "$f" ]] || { err "File not found"; return 1; }
  tar -tzf "$f" 2>/dev/null | grep -q '^data/' || { err "This does not look like a PR GRAM backup (no data/ folder inside)"; return 1; }
  ask "Current data will be replaced. Continue?" || return 0
  cmd_backup quiet
  dc stop
  tar -xzf "$f" -C "$DIR" && chown -R 1000:1000 "$DIR/data"
  dc up -d && ok "Restored"
}

# ---------------- cleanup and tuning ----------------
cmd_clean() {
  echo "${B}== Cleaning caches and extra space ==${N}"
  local before after; before=$(df --output=avail -B1M / | tail -1)
  docker image prune -f >/dev/null && ok "Unused images removed"
  docker builder prune -f >/dev/null && ok "Build cache removed"
  docker container prune -f >/dev/null && ok "Stopped containers removed"
  find "$DIR/data/logs" -name 'app.log.*' -mtime +3 -delete 2>/dev/null && ok "Old rotated logs removed"
  command -v journalctl >/dev/null && journalctl --vacuum-size=100M >/dev/null 2>&1 && ok "journal limited to 100MB"
  if command -v apt-get >/dev/null; then apt-get clean >/dev/null 2>&1 && apt-get autoremove -y >/dev/null 2>&1 && ok "apt cache cleaned"
  elif command -v dnf >/dev/null; then dnf clean all >/dev/null 2>&1 && ok "dnf cache cleaned"; fi
  find /tmp /var/tmp -xdev -type f -mtime +2 -delete 2>/dev/null; ok "Old temp files removed (older than 2 days)"
  sync; echo 1 > /proc/sys/vm/drop_caches 2>/dev/null && ok "Page cache released"
  after=$(df --output=avail -B1M / | tail -1)
  echo "${G}Space freed: $((after-before)) MB${N}"
}

cmd_vacuum() {
  [[ -f "$DIR/data/prgram.db" ]] || { err "Database not found: $DIR/data/prgram.db"; return 1; }
  warn "The service will be stopped for a few seconds."
  cmd_backup quiet
  dc stop
  local b a; b=$(du -k "$DIR/data/prgram.db" | cut -f1)
  if dc run --rm --no-deps -T app python - <<'PY'
import sqlite3
c = sqlite3.connect('/app/data/prgram.db', timeout=60)
if c.execute("select 1 from sqlite_master where name='pg_hist'").fetchone():
    c.execute("DELETE FROM pg_hist WHERE ts < CAST(strftime('%s','now') AS INTEGER) - 15*86400")
c.commit()
c.execute('PRAGMA wal_checkpoint(TRUNCATE)')
c.execute('VACUUM')
c.execute('PRAGMA optimize')
c.close()
PY
  then a=$(du -k "$DIR/data/prgram.db" | cut -f1); ok "Database compacted: ${b}KB → ${a}KB"
  else err "Compaction failed; data was left as it was (backup in $BK)"; fi
  dc up -d
}

cmd_optimize() {
  echo "${B}== Server tuning ==${N}"
  local cc="" bbr=0
  modprobe tcp_bbr 2>/dev/null || true
  if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then bbr=1; fi
  {
    echo "# selfpanel network/memory tuning"
    if (( bbr )); then echo "net.core.default_qdisc=fq"; echo "net.ipv4.tcp_congestion_control=bbr"; fi
    cat <<'CONF'
net.core.somaxconn=4096
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_keepalive_time=300
net.ipv4.tcp_keepalive_intvl=30
net.ipv4.ip_local_port_range=10240 65535
fs.file-max=1048576
vm.swappiness=10
vm.vfs_cache_pressure=80
CONF
  } > /etc/sysctl.d/99-selfpanel.conf
  (( bbr )) && echo tcp_bbr > /etc/modules-load.d/selfpanel-bbr.conf
  sysctl --system >/dev/null 2>&1 && ok "Kernel settings applied (BBR: $([[ $bbr -eq 1 ]] && echo yes || echo 'not supported by this kernel'), swappiness, somaxconn)"
  cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null); echo "Congestion control: ${cc:-unknown}"
  local mem_mb; mem_mb=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo)
  if (( mem_mb < 1500 )) && ! swapon --show | grep -q .; then
    { fallocate -l 1G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=1024 status=none; } \
      && chmod 600 /swapfile && mkswap /swapfile >/dev/null && swapon /swapfile \
      && { grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab; } && ok "1GB swap created"
  fi
  # system-wide Docker log rotation
  if [[ ! -f /etc/docker/daemon.json ]]; then
    mkdir -p /etc/docker
    echo '{"log-driver":"json-file","log-opts":{"max-size":"10m","max-file":"3"}}' > /etc/docker/daemon.json
    ok "Docker log rotation configured (applies after a Docker restart)"
  fi
  # accurate clock (matters for timeouts and tokens)
  timedatectl set-ntp true >/dev/null 2>&1 && ok "NTP enabled"
  ok "Done"
}

cmd_limits() {
  local m c nm nc; m=$(envget MEM_LIMIT); c=$(envget CPU_LIMIT)
  echo "Current: RAM=${m:-768m}  CPU=${c:-1.5}"
  read -rp "New RAM (e.g. 1g, empty = no change): " nm
  read -rp "New CPU (e.g. 2, empty = no change): " nc
  if [[ -n "$nm" && ! "$nm" =~ ^[0-9]+(\.[0-9]+)?[bkmgBKMG]?$ ]]; then err "Invalid RAM value"; return 1; fi
  if [[ -n "$nc" && ! "$nc" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then err "Invalid CPU value"; return 1; fi
  [[ -n "$nm" ]] && envset MEM_LIMIT "$nm"
  [[ -n "$nc" ]] && envset CPU_LIMIT "$nc"
  ensure_cpu_limit
  dc up -d && ok "Applied"
}

cmd_config() {
  echo "${B}Settings (secret values are hidden):${N}"
  sed -E 's/^(BOT_TOKEN|SESSION_KEY|API_HASH)=.+/\1=********/' "$DIR/.env"
  echo
  local k v; read -rp "Key to change (empty = exit): " k; [[ -z "$k" ]] && return
  [[ "$k" =~ ^[A-Z_][A-Z0-9_]*$ ]] || { err "Invalid key name (use UPPER_CASE_WITH_UNDERSCORES)"; return 1; }
  if [[ "$k" =~ (TOKEN|KEY|HASH|SECRET|PASSWORD) ]]; then read -rsp "New value (hidden): " v; echo; else read -rp "New value: " v; fi
  if [[ "$k" == "SESSION_KEY" ]]; then
    warn "Changing SESSION_KEY makes all saved sessions unreadable."
    ask "Really change it?" || return 0
  fi
  envset "$k" "$v"
  ask "Restart the service now?" && dc up -d --force-recreate
}

cmd_ports() { local p; p=$(host_port); ss -tlnp 2>/dev/null | awk -v p=":$p\$" 'NR==1||$4 ~ p'; }

cmd_health() {
  local p; p=$(host_port)
  if curl -fs --max-time 4 "http://127.0.0.1:$p/healthz" >/dev/null; then ok "Web panel is responding (port $p)"; else err "Web panel is not responding"; fi
  docker logs --tail 15 "$CT" 2>&1 | grep -Ei 'error|failed|flood' | tail -5 || true
}

cmd_uninstall() {
  ask "Remove the service? (data and backups are kept unless you choose otherwise)" || return 0
  dc --profile domain down --rmi local
  rm -f /usr/local/bin/selfpanel
  local x; read -rp "Type DELETE to also erase $DIR (data, backups, .env), or press Enter to keep it: " x
  if [[ "$x" == "DELETE" && -n "$DIR" && "$DIR" != "/" ]]; then
    rm -rf "$DIR" && ok "Removed everything, including $DIR"
  else
    ok "Removed. Your data is still in $DIR/data"
  fi
}

# ---------------- menu ----------------
menu() {
  while true; do
    [[ -t 1 ]] && clear
    echo "${C}${B}┌───────────────────────────────┐"
    echo "│     PR GRAM  ·  selfpanel     │"
    echo "└───────────────────────────────┘${N}"
    local st; st=$(docker inspect -f '{{.State.Status}}' "$CT" 2>/dev/null || echo "not installed")
    echo "Status: ${B}$st${N}   |   Free RAM: $(free -m | awk '/Mem/{print $7}')MB   |   Free disk: $(df -h / | awk 'NR==2{print $4}')"
    cat <<EOF

  ${B}Service${N}                        ${B}Maintenance${N}
   1) Status & resources          8) Backup
   2) Start                       9) Restore backup
   3) Stop                       10) Clean caches & disk
   4) Restart                    11) Compact database
   5) Live logs                  12) Tune server (BBR/swap)
   6) Admin link                 13) RAM/CPU limits
   7) Update                     14) Edit .env settings
                                 15) Health check
                                 16) Domain & SSL
   0) Exit                       99) Uninstall
EOF
    read -rp $'\n> ' ch || exit 0
    case "$ch" in
      1) cmd_status; pause;; 2) cmd_start; pause;; 3) cmd_stop; pause;; 4) cmd_restart; pause;;
      5) cmd_logs;; 6) cmd_adminlink; pause;; 7) cmd_update; pause;; 8) cmd_backup; pause;;
      9) cmd_restore; pause;; 10) cmd_clean; pause;; 11) cmd_vacuum; pause;; 12) cmd_optimize; pause;;
      13) cmd_limits; pause;; 14) cmd_config; pause;; 15) cmd_health; pause;; 16) cmd_domain; pause;; 99) cmd_uninstall; pause;;
      0|q) exit 0;; *) warn "Invalid option"; sleep 1;;
    esac
  done
}

case "${1:-menu}" in
  menu) menu;;
  status) cmd_status;; start) cmd_start;; stop) cmd_stop;; restart) cmd_restart;;
  logs) cmd_logs "${2:-100}";; link|adminlink) cmd_adminlink;;
  update) cmd_update "${2:-}";; backup) cmd_backup;; restore) cmd_restore "${2:-}";;
  clean) cmd_clean;; vacuum) cmd_vacuum;; optimize) cmd_optimize;; limits) cmd_limits;;
  config) cmd_config;; health) cmd_health;; ports) cmd_ports;; domain) cmd_domain;; logs-ssl) cmd_sslogs;; uninstall) cmd_uninstall;;
  *) usage; exit 1;;
esac
