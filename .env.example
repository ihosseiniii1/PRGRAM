# ---- الزامی ----
BOT_TOKEN=
OWNER_ID=

# ---- کلید رمزنگاری نشست‌ها (install.sh خودش می‌سازه؛ گم بشه همه نشست‌ها از بین می‌رن) ----
SESSION_KEY=

# ---- پیشنهادی ----
# API_ID / API_HASH خودت رو از my.telegram.org بگیر
API_ID=
API_HASH=
# ---- دامنه (install.sh یا دستور `selfpanel domain` این‌ها را خودکار پر می‌کند) ----
# رکورد A دامنه باید به IP سرور اشاره کند. SSL خودکار توسط Caddy گرفته می‌شود.
DOMAIN=
WEB_BASE_URL=
# با دامنه: 1 (پشت Caddy)؛ بدون دامنه: 0
TRUST_PROXY=0
# با دامنه: 127.0.0.1 (پورت مستقیم بسته می‌شود)؛ بدون دامنه: 0.0.0.0
BIND_IP=0.0.0.0
# با دامنه: domain ؛ بدون دامنه: خالی
COMPOSE_PROFILES=
OPEN_ACCESS=1
MAX_USERS=500

# ---- پورت روی هاست (داخل کانتینر همیشه 8787) ----
HOST_PORT=8787
MEM_LIMIT=768m
CPU_LIMIT=1.5
