# Automatic HTTPS (Let's Encrypt) for the domain set in .env  →  DOMAIN=panel.example.com
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:8787 {
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		level WARN
	}
}
